[Unit]
Description=Daily ONP catalog update

[Timer]
OnCalendar=*-*-* 06:00:00
# If the laptop was asleep/off when 06:00 passed, run as soon as
# it's back up instead of silently skipping that day -- this is
# the actual reason to use a timer over plain cron on a machine
# that isn't always on.
Persistent=true

[Install]
WantedBy=timers.target
